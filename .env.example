# Copy this file to .env and adjust if your setup differs.
DB_USER=system
DB_PASSWORD=
DB_CONNECT_STRING=localhost:1522/FREEPDB1
PORT=3000

# --- Authentication foundation (Phase 1 placeholders; auth not implemented yet) ---
# Secret used to sign JWTs. Generate a strong random value for your own .env —
# never commit a real value here.
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=15
JWT_TWO_FACTOR_CHALLENGE_EXPIRATION_MINUTES=5
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
CORS_ORIGIN=http://localhost:4200
