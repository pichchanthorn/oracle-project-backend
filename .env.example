# Copy this file to .env and adjust if your setup differs.
DB_USER=system
DB_PASSWORD=
DB_CONNECT_STRING=localhost:1522/FREEPDB1
PORT=3000

# --- Authentication / JWT configuration ---
# Secret used to sign JWTs. Must be at least 32 bytes — generate a strong
# random value for your own .env (e.g. `openssl rand -base64 48`).
# Never commit a real value here. The server refuses to start without one.
JWT_SECRET=
JWT_ISSUER=lumina-diamond-pos-api
JWT_AUDIENCE=lumina-diamond-pos
JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=15
JWT_TWO_FACTOR_CHALLENGE_EXPIRATION_MINUTES=5
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
CORS_ORIGIN=http://localhost:4200
